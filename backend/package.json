{
  "name": "amparo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Amparo: lembretes de medicação para cuidadores e pessoas acompanhadas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "db:up": "podman compose up -d db",
    "db:down": "podman compose down",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "node-pg-migrate": "^8.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
