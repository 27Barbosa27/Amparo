# Copie para .env e preencha. O .env NUNCA é enviado para o Git.
NODE_ENV=development
PORT=3000

POSTGRES_USER=amparo
POSTGRES_PASSWORD=mude-isto
POSTGRES_DB=amparo
DATABASE_URL=postgres://amparo:mude-isto@127.0.0.1:5432/amparo

# Segredos de autenticação (mínimo 32 caracteres cada). Gere valores aleatórios, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=mude-isto-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
EMAIL_PEPPER=mude-isto-por-outro-valor-aleatorio-com-pelo-menos-32-caracteres
