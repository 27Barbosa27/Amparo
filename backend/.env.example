# Copie para .env e preencha. O .env NUNCA é enviado para o Git.
NODE_ENV=development
PORT=3000

POSTGRES_USER=amparo
POSTGRES_PASSWORD=mude-isto
POSTGRES_DB=amparo
DATABASE_URL=postgres://amparo:mude-isto@127.0.0.1:5432/amparo
# Só em produção (ver deploy/): palavra-passe do utilizador amparo_runtime, com que a API se liga.
#APP_DB_PASSWORD=

# Segredos de autenticação (mínimo 32 caracteres cada). Gere valores aleatórios, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=mude-isto-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
EMAIL_PEPPER=mude-isto-por-outro-valor-aleatorio-com-pelo-menos-32-caracteres
# Chave de cifra do email (32 bytes aleatórios em base64url, ou seja 43 caracteres):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_ENC_KEY=mude-isto-por-32-bytes-aleatorios-em-base64url
# Chave-mestra dos perfis (32 bytes em base64url, 43 caracteres). Protege a chave de cifra de cada perfil.
PROFILE_MASTER_KEY=mude-isto-por-32-bytes-aleatorios-em-base64url
# Entrar com a Apple e a Google (opcionais; sem isto os endpoints respondem 501).
#APPLE_CLIENT_ID=pt.amparo.app
#GOOGLE_CLIENT_IDS=cliente-web.apps.googleusercontent.com,cliente-ios.apps.googleusercontent.com
# Push (Firebase Cloud Messaging, só para notificações). Caminho do JSON da conta de serviço; fora do Git.
#FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm-service-account.json
# Email (recuperação de palavra-passe). Qualquer fornecedor SMTP. Em desenvolvimento, o Mailpit (smtp://127.0.0.1:1025).
#SMTP_URL=smtps://utilizador:segredo@smtp.exemplo.com:465
#EMAIL_FROM=Amparo <nao-responder@amparo.pt>
#APP_LINK_BASE=https://amparo.pt/repor
# Só em desenvolvimento: a app web (Chrome) a chamar a API. Lista explícita de origens.
#CORS_ORIGINS=http://127.0.0.1:8099
