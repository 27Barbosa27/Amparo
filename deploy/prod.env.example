# Copiar para deploy/.env.prod e preencher. O ficheiro .env.prod NUNCA vai para o Git.
# Gerar cada segredo aleatório com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# e as chaves de 32 bytes com:        node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

AMPARO_DOMAIN=api.exemplo.pt

POSTGRES_USER=amparo
POSTGRES_PASSWORD=mude-isto
POSTGRES_DB=amparo

JWT_SECRET=mude-isto-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
EMAIL_PEPPER=mude-isto-por-outro-valor-aleatorio-com-pelo-menos-32-caracteres

# ATENÇÃO: sem estas duas chaves os dados cifrados ficam ILEGÍVEIS para sempre. Guardá-las num cofre,
# FORA da VPS e FORA dos backups da base de dados (se estivessem juntos, o backup não protegia nada).
EMAIL_ENC_KEY=mude-isto-por-32-bytes-aleatorios-em-base64url
PROFILE_MASTER_KEY=mude-isto-por-32-bytes-aleatorios-em-base64url

# Entrar com a Apple e a Google
APPLE_CLIENT_ID=pt.amparo.app
GOOGLE_CLIENT_IDS=cliente-web.apps.googleusercontent.com,cliente-ios.apps.googleusercontent.com

# Backups (usados pelo deploy/backup.sh): o identificador da chave PÚBLICA gpg que cifra os backups.
BACKUP_GPG_RECIPIENT=backups@amparo.example
