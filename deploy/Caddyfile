# TLS automático (Let's Encrypt) para o domínio da API. AMPARO_DOMAIN vem do ambiente do contentor.
{$AMPARO_DOMAIN} {
	encode zstd gzip

	# Corpos pequenos: a API não recebe ficheiros.
	request_body {
		max_size 200KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy api:3000 {
		# O IP verdadeiro segue no X-Forwarded-For; a API confia só neste proxy (TRUST_PROXY=1).
		header_up X-Forwarded-For {remote_host}
	}
}
